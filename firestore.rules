rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /users/{uid} {
      allow create, update: if isOwner(uid);
      allow read: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /gamificationAdmin/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /gamificationAdmin/{uid}/history/{entryId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow create: if (signedIn() && request.resource.data.uid == request.auth.uid) || (!signedIn() && request.resource.data.uid == null && request.resource.data.origen == "web" && request.resource.data.correo is string && request.resource.data.correo.size() > 3);
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
