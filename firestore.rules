rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // FUNCIONES
    // =========================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.admin == true;
    }

    // Verifica que ninguno de los dos usuarios haya bloqueado al otro
    function chatNotBlocked(otherUid) {
      return signedIn()
        && !exists(
          /databases/$(database)/documents/users/$(request.auth.uid)/blocked/$(otherUid)
        )
        && !exists(
          /databases/$(database)/documents/users/$(otherUid)/blocked/$(request.auth.uid)
        );
    }


    // =========================
    // USERS
    // =========================

    match /users/{uid} {

      allow read, create, update, delete:
        if isOwner(uid) || isAdmin();


      // =========================
      // USUARIOS BLOQUEADOS
      // =========================

      match /blocked/{blockedUid} {

        allow read, create, update, delete:
          if isOwner(uid) || isAdmin();
      }


      // =========================
      // AMIGOS
      // =========================

      match /friends/{friendUid} {

        allow read:
          if isOwner(uid)
          || isOwner(friendUid)
          || isAdmin();

        allow create:
          if isOwner(uid)
          || (
            isOwner(friendUid)
            && request.resource.data.uid == request.auth.uid
          );

        allow update, delete:
          if isOwner(uid)
          || isOwner(friendUid)
          || isAdmin();
      }
    }


    // =========================
    // PERFILES PÚBLICOS
    // =========================

    match /publicProfiles/{uid} {

      allow read:
        if signedIn();

      allow create, update, delete:
        if isOwner(uid) || isAdmin();
    }


    // =========================
    // DIRECTORIO DE AMIGOS
    // =========================

    match /friendDirectory/{friendCode} {

      allow read:
        if signedIn();

      allow create:
        if signedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update, delete:
        if (
          signedIn()
          && resource.data.uid == request.auth.uid
        )
        || isAdmin();
    }


    // =========================
    // SOLICITUDES DE AMISTAD
    // =========================

    match /friendRequests/{requestId} {

      allow read:
        if (
          signedIn()
          && (
            resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid
          )
        )
        || isAdmin();

      allow create:
        if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && !exists(
          /databases/$(database)/documents/users/$(request.auth.uid)/blocked/$(request.resource.data.toUid)
        )
        && !exists(
          /databases/$(database)/documents/users/$(request.resource.data.toUid)/blocked/$(request.auth.uid)
        );

      allow update:
        if signedIn()
        && (
          resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid
        )
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid;

      allow delete:
        if (
          signedIn()
          && (
            resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid
          )
        )
        || isAdmin();
    }


    // =========================
    // REPORTES DE PERFIL
    // =========================

    match /profileReports/{reportId} {

      allow create:
        if signedIn()
        && request.resource.data.reporterUid == request.auth.uid;

      allow read, update, delete:
        if isAdmin();
    }


    // =========================
    // NUEVOS REPORTES DE USUARIOS
    // =========================

    match /userReports/{reportId} {

      // Cualquier usuario autenticado puede crear
      // un reporte usando únicamente su propio UID
      allow create:
        if signedIn()
        && request.resource.data.reporterUid == request.auth.uid;

      // Solamente administradores pueden consultar,
      // modificar o eliminar reportes
      allow read, update, delete:
        if isAdmin();
    }


    // =========================
    // SOPORTE
    // =========================

    match /supportTickets/{ticketId} {

      // Un usuario con sesión reporta con su propio uid; alguien sin cuenta
      // (desde soporte.html, sin iniciar sesión) puede reportar también,
      // identificándose solo con su correo.
      allow create:
        if (
          signedIn()
          && request.resource.data.uid == request.auth.uid
        )
        ||
        (
          !signedIn()
          && request.resource.data.uid == null
          && request.resource.data.origen == "web"
          && request.resource.data.correo is string
          && request.resource.data.correo.size() > 3
        );

      allow read:
        if isAdmin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );

      allow update:
        if isAdmin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );

      allow delete:
        if isAdmin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );
    }


    // =========================
    // ACTIVIDAD DE USUARIOS
    // =========================

    match /userActivity/{eventId} {

      allow create:
        if signedIn()
        && request.resource.data.uid == request.auth.uid;

      allow read:
        if isAdmin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );

      allow update, delete:
        if isAdmin();
    }


    // =========================
    // DATOS ESCOLARES
    // =========================

    match /schoolData/{uid} {

      allow read, create, update, delete:
        if isOwner(uid) || isAdmin();
    }


    // =========================
    // TORTI COINS
    // =========================

    match /gamificationAdmin/{uid} {

      allow read:
        if isOwner(uid) || isAdmin();

      allow create, update:
        if isAdmin();

      allow delete:
        if isAdmin();


      // =========================
      // HISTORIAL TORTI COINS
      // =========================

      match /history/{entryId} {

        allow read:
          if isOwner(uid) || isAdmin();

        allow create:
          if isAdmin();

        allow update, delete:
          if isAdmin();
      }
    }


    // =========================
    // CHATS INDIVIDUALES
    // =========================

    match /chats/{chatId} {

      // El admin puede leer para investigar reportes de acoso/abuso;
      // nunca puede crear, editar ni borrar mensajes ajenos.
      allow read:
        if (
          signedIn()
          && request.auth.uid in resource.data.members
        )
        || isAdmin();

      allow create:
        if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2
        && chatNotBlocked(
          request.resource.data.members[0] == request.auth.uid
            ? request.resource.data.members[1]
            : request.resource.data.members[0]
        );

      allow update:
        if signedIn()
        && request.auth.uid in resource.data.members;

      allow delete:
        if false;


      // =========================
      // MENSAJES
      // =========================

      match /messages/{messageId} {

        allow read:
          if (
            signedIn()
            && request.auth.uid in
               get(
                 /databases/$(database)/documents/chats/$(chatId)
               ).data.members
            && chatNotBlocked(
                 request.auth.uid ==
                 get(
                   /databases/$(database)/documents/chats/$(chatId)
                 ).data.members[0]
                   ? get(
                       /databases/$(database)/documents/chats/$(chatId)
                     ).data.members[1]
                   : get(
                       /databases/$(database)/documents/chats/$(chatId)
                     ).data.members[0]
               )
          )
          || isAdmin();

        allow create:
          if signedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.recipientUid is string
          && request.resource.data.recipientUid != request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 4000
          && request.auth.uid in
             get(
               /databases/$(database)/documents/chats/$(chatId)
             ).data.members
          && request.resource.data.recipientUid in
             get(
               /databases/$(database)/documents/chats/$(chatId)
             ).data.members
          && chatNotBlocked(request.resource.data.recipientUid);

        allow update:
          if signedIn()
          && request.auth.uid in
             get(
               /databases/$(database)/documents/chats/$(chatId)
             ).data.members
          && (
            (
              resource.data.senderUid == request.auth.uid
              && request.resource.data.senderUid == resource.data.senderUid
            )
            ||
            (
              resource.data.recipientUid == request.auth.uid
            )
          );

        allow delete:
          if signedIn()
          && resource.data.senderUid == request.auth.uid;
      }
    }


    // =========================
    // GRUPOS
    // =========================

    match /groups/{groupId} {

      // El admin puede leer para investigar reportes de grupos; nunca puede
      // crear, editar ni borrar grupos ajenos.
      allow read:
        if (
          signedIn()
          && request.auth.uid in resource.data.members
        )
        || isAdmin();


      // CREAR GRUPO
      allow create:
        if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.members
        && request.auth.uid in request.resource.data.admins
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80;


      // ACTUALIZACIONES DEL GRUPO
      allow update:
        if signedIn()
        && request.auth.uid in resource.data.members;


      // ELIMINAR GRUPO
      allow delete:
        if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.members.size() == 1;


      // =========================
      // MENSAJES DE GRUPO
      // =========================

      match /messages/{messageId} {

        allow read:
          if (
            signedIn()
            && request.auth.uid in
               get(
                 /databases/$(database)/documents/groups/$(groupId)
               ).data.members
          )
          || isAdmin();

        allow create:
          if signedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 4000
          && request.auth.uid in
             get(
               /databases/$(database)/documents/groups/$(groupId)
             ).data.members;

        allow update:
          if signedIn()
          && request.auth.uid in
             get(
               /databases/$(database)/documents/groups/$(groupId)
             ).data.members
          && (
            request.resource.data.senderUid == resource.data.senderUid
            || request.resource.data.senderUid == request.auth.uid
          );

        allow delete:
          if signedIn()
          && resource.data.senderUid == request.auth.uid;
      }
    }
  }
}
